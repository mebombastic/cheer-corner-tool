{
 "id": "2026-10-02-ne-jedite-imetak-na-nedozvoljen-nacin",
 "model": "whisper large-v3-turbo",
 "language": "bs",
 "segments": [
  {
   "start": 0.82,
   "end": 3.2,
   "text": "Alhamdulillahi Rabbil A'alamin"
  },
  {
   "start": 3.2,
   "end": 9.66,
   "text": "والصلاة والسلام على رسولنا محمد وآله وصحبه يجمعين"
  },
  {
   "start": 9.66,
   "end": 13.56,
   "text": "قال الله تعالى في كتابه الكريم"
  },
  {
   "start": 13.56,
   "end": 16.62,
   "text": "يعوذ بالله من الشيطان الرجيم"
  },
  {
   "start": 16.62,
   "end": 18.42,
   "text": "بسم الله الرحمن الرحيم"
  },
  {
   "start": 18.42,
   "end": 23.24,
   "text": "ولا تأكلوا أموالكم بينكم بالباطل"
  },
  {
   "start": 23.24,
   "end": 29.1,
   "text": "وتضلوا بها إلى الحكام لتأكلوا فريقا من أموال الناس"
  },
  {
   "start": 29.1,
   "end": 33.52,
   "text": "bil ithmi wa antum ta'alamun, sadaqallahun a'zim."
  },
  {
   "start": 35.26,
   "end": 39.36,
   "text": "Zahvala pripada Allahu tabaraka wa ta'ala, gospodarus i sveta,"
  },
  {
   "start": 40.26,
   "end": 45.26,
   "text": "neksunashi salavati salami upochaninu Muhammeda sallallahu alaihi wa sallam"
  },
  {
   "start": 45.26,
   "end": 50.58,
   "text": "na nigu porodi sunnigala ashaabe i sfeone, kuega budu sledili svetu sunnidan,"
  },
  {
   "start": 51.58,
   "end": 54.28,
   "text": "naibodi govori govara allaha tabaraka wa ta'ala,"
  },
  {
   "start": 54.28,
   "end": 57.78,
   "text": "a naiboda uputa i uputa Muhammeda sallallahu alaihi wa sallam."
  },
  {
   "start": 57.78,
   "end": 79.86,
   "text": "Tema današnje hudbe jeste bespravno jedenje tuđeg i metka. Jedna od velikih opasnosti za pojedinca i društvo jeste bespravno jedenje tuđeg i metka."
  },
  {
   "start": 79.86,
   "end": 99.2,
   "text": "Pa zato Allah Đalešanu mu kaže, ne jedite imovinu jedan drugog, na nepošten način i ne parničite se zbog nje pred sudjama da biste na griješan način i svjesno dio tuđe imovine pojeli."
  },
  {
   "start": 99.2,
   "end": 103.76,
   "text": "odtuda je i Allah poslanik"
  },
  {
   "start": 103.76,
   "end": 105.02,
   "text": "sallallahu alayhi wa sallam"
  },
  {
   "start": 105.02,
   "end": 106.46,
   "text": "rekao"
  },
  {
   "start": 106.46,
   "end": 111.26,
   "text": "zaista su vaša krv"
  },
  {
   "start": 111.26,
   "end": 113.24,
   "text": "vaši metak"
  },
  {
   "start": 113.24,
   "end": 114.76,
   "text": "i vaša čast"
  },
  {
   "start": 114.76,
   "end": 117.68,
   "text": "sveti i nepovredivi"
  },
  {
   "start": 117.68,
   "end": 119.88,
   "text": "zato muslimanu"
  },
  {
   "start": 119.88,
   "end": 120.7,
   "text": "nije dozvoljeno"
  },
  {
   "start": 120.7,
   "end": 123.28,
   "text": "da uzme ono što mu ne pripada"
  },
  {
   "start": 123.28,
   "end": 125.06,
   "text": "bilo prevarom"
  },
  {
   "start": 125.06,
   "end": 127.84,
   "text": "pronevjerom, lažnom zakletvom"
  },
  {
   "start": 127.84,
   "end": 129.92,
   "text": "iskoristavanjem"
  },
  {
   "start": 129.92,
   "end": 131.42,
   "text": "tuđeg povjerenja"
  },
  {
   "start": 131.42,
   "end": 132.28,
   "text": "i tako dalje"
  },
  {
   "start": 132.28,
   "end": 164.5,
   "text": "Kada kaže Allah za Lšanohu nemojte jesti imetke jednih drugih na nepošten način, koristi se izraz za nepošten način, izraz u Korani kerimu jeste bir batin, što obuhvata da je to nedozvoreni način koji obuhvata različite načine nepravednog sticanja tuđeg imetka."
  },
  {
   "start": 164.84,
   "end": 171.66,
   "text": "poput krađe, poput kamate, poput mita, poput korupcije"
  },
  {
   "start": 171.66,
   "end": 178.24,
   "text": "i drugih vidova bespravnog jedenja tuđeg i metkva."
  },
  {
   "start": 179.64,
   "end": 184.14,
   "text": "Kada bi govorili o svim tim načinima i vrstama,"
  },
  {
   "start": 184.9,
   "end": 187.22,
   "text": "dakle, nedozvonenog sticanja i metka,"
  },
  {
   "start": 187.22,
   "end": 193.06,
   "text": "dakle, na neki način lista bi bila previše dugačka."
  },
  {
   "start": 193.06,
   "end": 222.03,
   "text": "A ja ću za ovu priliku da spomenem nekoliko tačke na koji se to način čovjek stiče i metak, a to je nedozvoljeni način sticanja i metka putem brevare, putem pronevjera povjerenog i metka, zlopotreba službenog položaja, lažna zakletva kako bi prisvojio tuđi i metak,"
  },
  {
   "start": 222.03,
   "end": 224.85,
   "text": "dug koji čovjek namjerno ne vraća"
  },
  {
   "start": 224.85,
   "end": 227.05,
   "text": "tuđi metak"
  },
  {
   "start": 227.05,
   "end": 229.31,
   "text": "nije halan samo zato što ga možemo uzeti"
  },
  {
   "start": 229.31,
   "end": 230.91,
   "text": "i što je ta azir"
  },
  {
   "start": 230.91,
   "end": 231.49,
   "text": "i teuba"
  },
  {
   "start": 231.49,
   "end": 236.22,
   "text": "kada govorimo o prevari"
  },
  {
   "start": 236.22,
   "end": 236.8,
   "text": "draga bračo"
  },
  {
   "start": 236.8,
   "end": 239.28,
   "text": "pejgamber sada laoneva sama mi je jedna prilike"
  },
  {
   "start": 239.28,
   "end": 240.92,
   "text": "bio na pijaci tamo i vidio"
  },
  {
   "start": 240.92,
   "end": 242.72,
   "text": "nekog čovjeka kako prodaje žito"
  },
  {
   "start": 242.72,
   "end": 246.48,
   "text": "odozgo žito super"
  },
  {
   "start": 246.48,
   "end": 248.4,
   "text": "ekstra kvalitetno dobro"
  },
  {
   "start": 248.4,
   "end": 250.44,
   "text": "kaže pejgambera da je sratio"
  },
  {
   "start": 250.44,
   "end": 251.72,
   "text": "sram je zavukuo ruku"
  },
  {
   "start": 251.72,
   "end": 254.68,
   "text": "unutar toga džaka"
  },
  {
   "start": 254.68,
   "end": 257.78,
   "text": "i vidio da je pokvašeno to žito."
  },
  {
   "start": 258.7,
   "end": 261.66,
   "text": "Kaže, o vlasniče ove hrane, što to prodaje?"
  },
  {
   "start": 262.46,
   "end": 266.36,
   "text": "Kaže, ja razudala, kiša bi ga fatila, kiša, pokvasila,"
  },
  {
   "start": 266.74,
   "end": 269.48,
   "text": "pa dobro be, zašto ne si stavio ono što je mokro,"
  },
  {
   "start": 269.86,
   "end": 271.94,
   "text": "povrk tog džaka, da se to vidi?"
  },
  {
   "start": 273.18,
   "end": 275.3,
   "text": "Pa onda je pekamber, da je srato u sram, rekao,"
  },
  {
   "start": 275.38,
   "end": 281.03,
   "text": "koja nas vara nije naša, koja nas vara nije naša,"
  },
  {
   "start": 281.03,
   "end": 284.97,
   "text": "ovo ne znači nije musliman, ovo ne znači da on nije musliman,"
  },
  {
   "start": 284.97,
   "end": 295.79,
   "text": "Ne, nego prevara, mi ne poznajemo prevaru, a onaj ko se bavi prevarom nije naš, jer mi se ne bavimo prevarom."
  },
  {
   "start": 297.05,
   "end": 299.27,
   "text": "Zato tako kaže pigramec sada da, on je u srna."
  },
  {
   "start": 300.93,
   "end": 306.75,
   "text": "Prevara nije samo u trgovini, prevara nije samo kada čovjek ukrade novac iz ruke nekog čovjeka."
  },
  {
   "start": 309.56,
   "end": 312.86,
   "text": "Prevara ima na više načina."
  },
  {
   "start": 316.63,
   "end": 321.29,
   "text": "Dakle, prevaranje je prikrivanje istine kako bi se došlo do novca."
  },
  {
   "start": 322.83,
   "end": 327.43,
   "text": "Ko uzme kredit na tuđe ime, on nosi finansijsku štetu,"
  },
  {
   "start": 328.07,
   "end": 332.17,
   "text": "pripisuje dug drugome, taj drugi ima problem sa bankom,"
  },
  {
   "start": 332.89,
   "end": 334.69,
   "text": "kao i to što mu se narušava ugled."
  },
  {
   "start": 335.15,
   "end": 341.76,
   "text": "Tuđe ime nije dozvola za tuđi novac."
  },
  {
   "start": 342.44,
   "end": 344.96,
   "text": "Tuđi dokument nije tvoj dokument."
  },
  {
   "start": 344.96,
   "end": 347.9,
   "text": "tuđi potpis nije tvoj potpis"
  },
  {
   "start": 347.9,
   "end": 349.44,
   "text": "taj epigamber"
  },
  {
   "start": 349.44,
   "end": 350.86,
   "text": "da je sratu sram rekao"
  },
  {
   "start": 350.86,
   "end": 352.18,
   "text": "nema štete"
  },
  {
   "start": 352.18,
   "end": 355.14,
   "text": "niti nanošenja štete"
  },
  {
   "start": 355.14,
   "end": 358.02,
   "text": "nema štete"
  },
  {
   "start": 358.02,
   "end": 360.34,
   "text": "niti da nanosiš nekome štetu"
  },
  {
   "start": 360.34,
   "end": 365.25,
   "text": "i ovaj Hades je prihvaćen"
  },
  {
   "start": 365.25,
   "end": 367.15,
   "text": "kao jedno veliko islamsko pravilo"
  },
  {
   "start": 367.15,
   "end": 370.72,
   "text": "muslima ne smije"
  },
  {
   "start": 370.72,
   "end": 373.08,
   "text": "nanositi štetu"
  },
  {
   "start": 373.08,
   "end": 373.58,
   "text": "drugima"
  },
  {
   "start": 373.58,
   "end": 377.08,
   "text": "drugo"
  },
  {
   "start": 377.08,
   "end": 380.97,
   "text": "pro nevjera"
  },
  {
   "start": 380.97,
   "end": 384.01,
   "text": "dakle povjerenot"
  },
  {
   "start": 384.01,
   "end": 385.51,
   "text": "i metka"
  },
  {
   "start": 385.51,
   "end": 412.32,
   "text": "Ako je čovjeku neko povjerio novac, ako je čovjeku povjerio službeni auto, ako je čovjeku povjerio nešto od emaneta što ne pripada njimu, a on hoće da prisvoji, to je pronemirao."
  },
  {
   "start": 413.22,
   "end": 413.96,
   "text": "To je pronimljiran."
  },
  {
   "start": 413.96,
   "end": 416.32,
   "text": "A znate, kada je"
  },
  {
   "start": 416.32,
   "end": 418.32,
   "text": "pejgambera Reis Rato Sram"
  },
  {
   "start": 418.32,
   "end": 420.26,
   "text": "izvršio Hidru"
  },
  {
   "start": 420.26,
   "end": 422.18,
   "text": "i otišao u Medinu, ostavio je"
  },
  {
   "start": 422.18,
   "end": 424.14,
   "text": "Hazreti Aliju u Meku."
  },
  {
   "start": 425.46,
   "end": 426.34,
   "text": "Jedan od razloga"
  },
  {
   "start": 426.34,
   "end": 428.38,
   "text": "zašto je ostao Hazreti Alijan"
  },
  {
   "start": 428.38,
   "end": 430.02,
   "text": "jeste da"
  },
  {
   "start": 430.02,
   "end": 432.26,
   "text": "vrati sve"
  },
  {
   "start": 432.26,
   "end": 433.92,
   "text": "povjerene stvari koje je"
  },
  {
   "start": 433.92,
   "end": 436.12,
   "text": "čuvao Muhammed Sadladao Nevosadlan"
  },
  {
   "start": 436.12,
   "end": 437.02,
   "text": "kod sebe."
  },
  {
   "start": 437.84,
   "end": 440.24,
   "text": "Ljudima da vrati povjerene stvari."
  },
  {
   "start": 440.24,
   "end": 444.21,
   "text": "taj je pegambara leje sratu"
  },
  {
   "start": 444.21,
   "end": 445.85,
   "text": "sram, drag braćo, rekao, nema imana"
  },
  {
   "start": 445.85,
   "end": 446.97,
   "text": "onaj koje nema imaneta"
  },
  {
   "start": 446.97,
   "end": 452.68,
   "text": "nema imana onaj koje nema imaneta"
  },
  {
   "start": 452.68,
   "end": 455.88,
   "text": "ako ti se nešto povjerilo"
  },
  {
   "start": 455.88,
   "end": 458.44,
   "text": "treba dobro da čulaš, da panziš"
  },
  {
   "start": 458.44,
   "end": 460.42,
   "text": "jer ćeš zato"
  },
  {
   "start": 460.42,
   "end": 461.64,
   "text": "biti pitan"
  },
  {
   "start": 461.64,
   "end": 464.84,
   "text": "jer ćeš zato odgovarati pred Allahom"
  },
  {
   "start": 464.84,
   "end": 468.84,
   "text": "dakle"
  },
  {
   "start": 468.84,
   "end": 471.14,
   "text": "i metak, stvari"
  },
  {
   "start": 471.14,
   "end": 474.38,
   "text": "automobili"
  },
  {
   "start": 474.38,
   "end": 476.76,
   "text": "bilo što nešto što ti je"
  },
  {
   "start": 476.76,
   "end": 477.48,
   "text": "povjereno"
  },
  {
   "start": 477.48,
   "end": 479.56,
   "text": "da li od pojedinca"
  },
  {
   "start": 479.56,
   "end": 480.74,
   "text": "da li od države"
  },
  {
   "start": 480.74,
   "end": 484.2,
   "text": "to treba da se čuva"
  },
  {
   "start": 484.2,
   "end": 488.64,
   "text": "i da se na kraju vrati onome"
  },
  {
   "start": 488.64,
   "end": 490.16,
   "text": "kome pripada"
  },
  {
   "start": 490.16,
   "end": 491.8,
   "text": "zatim ima"
  },
  {
   "start": 491.8,
   "end": 496.41,
   "text": "zloupotreba službenog položaja"
  },
  {
   "start": 496.41,
   "end": 502.38,
   "text": "koji su na neku funkciju"
  },
  {
   "start": 502.38,
   "end": 504.4,
   "text": "da li su sebi za pravo"
  },
  {
   "start": 504.4,
   "end": 506.32,
   "text": "da rade što god oni misle da rade"
  },
  {
   "start": 506.32,
   "end": 510.46,
   "text": "jer imaju imunitet"
  },
  {
   "start": 510.46,
   "end": 512.4,
   "text": "to Bože imaju nekakav imunitet"
  },
  {
   "start": 512.4,
   "end": 514.48,
   "text": "njih zakon ne kače"
  },
  {
   "start": 514.48,
   "end": 518.11,
   "text": "oni mogu"
  },
  {
   "start": 518.11,
   "end": 518.93,
   "text": "što hoće da rade"
  },
  {
   "start": 518.93,
   "end": 520.53,
   "text": "ne, ne, ne"
  },
  {
   "start": 520.53,
   "end": 522.37,
   "text": "funkcija"
  },
  {
   "start": 522.37,
   "end": 523.71,
   "text": "u vreme Rasulullah"
  },
  {
   "start": 523.71,
   "end": 527.25,
   "text": "funkcija bila je manet istu dravbrać"
  },
  {
   "start": 527.25,
   "end": 528.91,
   "text": "jedne privike"
  },
  {
   "start": 528.91,
   "end": 530.21,
   "text": "pegambara ne je svato sram"
  },
  {
   "start": 530.21,
   "end": 531.83,
   "text": "poslao nekog čovjeka da ubire"
  },
  {
   "start": 531.83,
   "end": 533.15,
   "text": "zekat"
  },
  {
   "start": 533.15,
   "end": 536.29,
   "text": "i čovjek otišao tamo"
  },
  {
   "start": 536.29,
   "end": 538.01,
   "text": "u neko svoje određeno mjesto"
  },
  {
   "start": 538.01,
   "end": 540.25,
   "text": "sakupio zekat i došao"
  },
  {
   "start": 540.25,
   "end": 542.03,
   "text": "da donese zekat"
  },
  {
   "start": 542.03,
   "end": 543.07,
   "text": "kod poslanika"
  },
  {
   "start": 543.07,
   "end": 546.53,
   "text": "pa mu kaže"
  },
  {
   "start": 546.53,
   "end": 548.15,
   "text": "ovo je za tebe"
  },
  {
   "start": 548.15,
   "end": 550.19,
   "text": "ovo je za tebe, ovo je za tebe, a ovo je za mene."
  },
  {
   "start": 551.75,
   "end": 552.97,
   "text": "A, tako."
  },
  {
   "start": 555.1,
   "end": 556.36,
   "text": "Dobro, kad bi bio"
  },
  {
   "start": 556.36,
   "end": 558.28,
   "text": "kod kuće, kaže, pejgama rade"
  },
  {
   "start": 558.28,
   "end": 559.04,
   "text": "i sratu sramu."
  },
  {
   "start": 560.12,
   "end": 562.44,
   "text": "Kad bi bio kod kuće, kada ne bi imao"
  },
  {
   "start": 562.44,
   "end": 563.78,
   "text": "taj zadatak koji si imao"
  },
  {
   "start": 563.78,
   "end": 565.34,
   "text": "da obaviš taj zadatak,"
  },
  {
   "start": 565.78,
   "end": 568.6,
   "text": "da li bi dobio taj poklan, te što kažeš da je to poklan,"
  },
  {
   "start": 569.92,
   "end": 570.58,
   "text": "kad bi stojio"
  },
  {
   "start": 570.58,
   "end": 572.4,
   "text": "kod svojih roditela"
  },
  {
   "start": 572.4,
   "end": 574.32,
   "text": "da te nisam"
  },
  {
   "start": 574.32,
   "end": 576.28,
   "text": "poslao tamo, da li bi dobio taj poklan?"
  },
  {
   "start": 578.36,
   "end": 578.7,
   "text": "Kaže,"
  },
  {
   "start": 580.84,
   "end": 583.26,
   "text": "Ostavi, i to je dio zakat."
  },
  {
   "start": 586.89,
   "end": 589.47,
   "text": "I to je dio zakat."
  },
  {
   "start": 593.75,
   "end": 597.91,
   "text": "Zatim, lažna zakletva kako bi prisvojio tuđi metak."
  },
  {
   "start": 600.46,
   "end": 606.58,
   "text": "Kaže, i ne koristite svoje zakletve kako bi kao sredstvo prevare među sobom."
  },
  {
   "start": 606.58,
   "end": 613.42,
   "text": "Da se zakuneš u Allahom i da uzrneš tuđi metak."
  },
  {
   "start": 614.42,
   "end": 619.94,
   "text": "Pod zakletvom, to je prekršaj na prekršaj."
  },
  {
   "start": 619.94,
   "end": 622.26,
   "text": "prekrša je zbog zakletve"
  },
  {
   "start": 622.26,
   "end": 624.44,
   "text": "prekrša je zbog onoga što hoćeš"
  },
  {
   "start": 624.44,
   "end": 625.52,
   "text": "da prigrabiš"
  },
  {
   "start": 625.52,
   "end": 629.68,
   "text": "kaže pigamber a rej sratu sram"
  },
  {
   "start": 629.68,
   "end": 630.94,
   "text": "ko se zakone zakletom"
  },
  {
   "start": 630.94,
   "end": 633.18,
   "text": "kojom želi uzeti imetak muslimana"
  },
  {
   "start": 633.18,
   "end": 636.83,
   "text": "a pritom laže"
  },
  {
   "start": 636.83,
   "end": 639.15,
   "text": "pri zakletvi laže"
  },
  {
   "start": 639.15,
   "end": 641.69,
   "text": "kaže sreće Allaha Đalešanova"
  },
  {
   "start": 641.69,
   "end": 643.95,
   "text": "Allah Đalešanova će biti srdit na njega"
  },
  {
   "start": 643.95,
   "end": 650.16,
   "text": "pa ne možemo kazati"
  },
  {
   "start": 650.16,
   "end": 652.3,
   "text": "pa eto be odza 10 evra"
  },
  {
   "start": 652.3,
   "end": 653.56,
   "text": "be šta ima 10 evra"
  },
  {
   "start": 653.56,
   "end": 656.56,
   "text": "pošti be ne gleda Allah Đalešanova količinu"
  },
  {
   "start": 656.56,
   "end": 681.13,
   "text": "Ne gleda Allah Zadešanu u količinu. Znate šta gleda Allah Zadešanu? Allah gleda u nepravdu, bez obzira o kojoj količini je riječ. Prevara, nepravda, to gleda Allah Zadešanu, a ne koliko i za koliko si mogao da prevariš i da otmeš tuđi metak."
  },
  {
   "start": 681.13,
   "end": 705.31,
   "text": "Ne zakoliko, zakoliko plus, nebo način. Allah gleda način na koji to način dočiniš, radiš. Pa je svaka nepravda, nepravda, ako bi gledali nepravdu kroz novac da je izvršena nepravda sticanjem imetka ili novca na nedozvodeni način, nepravda."
  },
  {
   "start": 711.33,
   "end": 721.13,
   "text": "Onda ima, rekli smo tuđi metak, tuđi metak nije halal, samo zato što ga možemo uzeti."
  },
  {
   "start": 724.59,
   "end": 729.63,
   "text": "Musliman ne sme da razmišlja da uzme."
  },
  {
   "start": 731.23,
   "end": 737.27,
   "text": "Musliman treba da pita sebe da li mi je to dozvoljeno, da li mi je Allah to dozvolio da uzmem."
  },
  {
   "start": 740.36,
   "end": 741.12,
   "text": "A nije dozvoljeno."
  },
  {
   "start": 742.44,
   "end": 743.2,
   "text": "A nije dozvoljeno."
  },
  {
   "start": 743.2,
   "end": 780.0,
   "text": "E sad, može se uzeti tuđi metak, dakle, imati pristup na sljedeći način, imati ključ, možeš imati službeni račun, možeš imati tuđu karticu ili tuđa dokumenta, ali opet to ne daje za pravo čovjeku da to zloupotrebi i da uzme."
  },
  {
   "start": 780.0,
   "end": 782.0,
   "text": "jedne prilike"
  },
  {
   "start": 782.0,
   "end": 783.32,
   "text": "Hazretiomer"
  },
  {
   "start": 783.32,
   "end": 785.68,
   "text": "vidio jedno od dječaka"
  },
  {
   "start": 785.68,
   "end": 787.88,
   "text": "kako čuva ovce"
  },
  {
   "start": 787.88,
   "end": 791.18,
   "text": "kaže mu"
  },
  {
   "start": 791.18,
   "end": 793.22,
   "text": "tom dječaku Hazretiomer"
  },
  {
   "start": 793.22,
   "end": 795.8,
   "text": "daj bi da uzmem jednu ovcu ovako"
  },
  {
   "start": 795.8,
   "end": 797.08,
   "text": "kaže bi"
  },
  {
   "start": 797.08,
   "end": 799.46,
   "text": "ohalifo"
  },
  {
   "start": 799.46,
   "end": 803.47,
   "text": "pa ovce nisu moje"
  },
  {
   "start": 803.47,
   "end": 805.67,
   "text": "kaže čije su"
  },
  {
   "start": 805.67,
   "end": 808.11,
   "text": "kaže ovce su"
  },
  {
   "start": 808.11,
   "end": 809.79,
   "text": "tog i tog čovjeka"
  },
  {
   "start": 809.79,
   "end": 811.91,
   "text": "taj i taj čovjek je"
  },
  {
   "start": 811.91,
   "end": 813.07,
   "text": "gazda"
  },
  {
   "start": 813.07,
   "end": 815.79,
   "text": "kod koga ja radim."
  },
  {
   "start": 816.89,
   "end": 817.33,
   "text": "Kaže"
  },
  {
   "start": 817.33,
   "end": 819.43,
   "text": "tom gazdi tvome"
  },
  {
   "start": 819.43,
   "end": 821.57,
   "text": "ovcu je"
  },
  {
   "start": 821.57,
   "end": 826.32,
   "text": "pojeo vuk. A dječak"
  },
  {
   "start": 826.32,
   "end": 827.96,
   "text": "mu mudro kaže, a gdje je Allah"
  },
  {
   "start": 827.96,
   "end": 832.27,
   "text": "zalašano? E mi možemo sakriti"
  },
  {
   "start": 832.27,
   "end": 833.79,
   "text": "prevaru,"
  },
  {
   "start": 834.17,
   "end": 836.19,
   "text": "možemo sakriti i metak, možemo"
  },
  {
   "start": 836.19,
   "end": 838.53,
   "text": "sakriti dokumenta,"
  },
  {
   "start": 838.63,
   "end": 840.03,
   "text": "možemo se lažno predstavljati,"
  },
  {
   "start": 840.17,
   "end": 842.47,
   "text": "možemo sva što da radimo na Dunjaluku,"
  },
  {
   "start": 845.2,
   "end": 846.04,
   "text": "ali pred Allahom"
  },
  {
   "start": 846.04,
   "end": 849.57,
   "text": "ništa ne možemo sakriti."
  },
  {
   "start": 849.57,
   "end": 852.57,
   "text": "Pa je Hazreti Omer toliko bio radostan."
  },
  {
   "start": 853.25,
   "end": 857.25,
   "text": "Zašto je uvidio kod dječaka vjeru u Allaha te barake vtahana?"
  },
  {
   "start": 858.05,
   "end": 859.21,
   "text": "Spoznaju Allaha."
  },
  {
   "start": 860.17,
   "end": 863.23,
   "text": "Da ništa čovjek ne može sakriti od Allaha."
  },
  {
   "start": 863.35,
   "end": 867.19,
   "text": "Možeš od mene da sakriješ, možeš od njega da sakriješ, možeš od njega da sakriješ."
  },
  {
   "start": 867.73,
   "end": 869.61,
   "text": "Ali od Allaha ne može sakriti ništa."
  },
  {
   "start": 871.35,
   "end": 874.13,
   "text": "I sveće jednog dana izaći na vidjelo."
  },
  {
   "start": 876.4,
   "end": 878.38,
   "text": "Ama nesam ja kako, be nesam joj, koje je?"
  },
  {
   "start": 879.38,
   "end": 880.42,
   "text": "Pa ti si bre."
  },
  {
   "start": 880.88,
   "end": 882.88,
   "text": "Ti si"
  },
  {
   "start": 882.88,
   "end": 886.21,
   "text": "Ti si"
  },
  {
   "start": 886.21,
   "end": 887.25,
   "text": "E sad"
  },
  {
   "start": 887.25,
   "end": 891.54,
   "text": "Dug"
  },
  {
   "start": 891.54,
   "end": 893.58,
   "text": "Kaže Allah Završanu"
  },
  {
   "start": 893.58,
   "end": 895.7,
   "text": "Ono što uzmete zapišite"
  },
  {
   "start": 895.7,
   "end": 896.96,
   "text": "To je do određenog roka"
  },
  {
   "start": 896.96,
   "end": 899.32,
   "text": "I to je najduži ajet"
  },
  {
   "start": 899.32,
   "end": 902.0,
   "text": "Koji govori o dugu recimo tamo"
  },
  {
   "start": 902.0,
   "end": 905.52,
   "text": "Ali se u hadisu poslanika"
  },
  {
   "start": 905.52,
   "end": 906.72,
   "text": "To se vam kaže"
  },
  {
   "start": 906.72,
   "end": 908.54,
   "text": "Ko uzme i metan"
  },
  {
   "start": 908.54,
   "end": 910.6,
   "text": "Ljudi"
  },
  {
   "start": 910.6,
   "end": 912.06,
   "text": "Želeći da ga vrati"
  },
  {
   "start": 912.06,
   "end": 914.32,
   "text": "Želeći da ga vrati"
  },
  {
   "start": 914.32,
   "end": 916.18,
   "text": "Allah će mu pomoći da ga vrati"
  },
  {
   "start": 916.18,
   "end": 918.6,
   "text": "ali ako uzmeš"
  },
  {
   "start": 918.6,
   "end": 920.7,
   "text": "dakle"
  },
  {
   "start": 920.7,
   "end": 922.44,
   "text": "tuđi imetak"
  },
  {
   "start": 922.44,
   "end": 925.52,
   "text": "sa namjerom da uništiš"
  },
  {
   "start": 925.52,
   "end": 926.2,
   "text": "taj imetak"
  },
  {
   "start": 926.2,
   "end": 927.82,
   "text": "kaže su u hadisu"
  },
  {
   "start": 927.82,
   "end": 929.46,
   "text": "a ona će njega uništiti"
  },
  {
   "start": 929.46,
   "end": 930.4,
   "text": "kad tad"
  },
  {
   "start": 930.4,
   "end": 939.28,
   "text": "i znate"
  },
  {
   "start": 939.28,
   "end": 943.56,
   "text": "da dug treba da se vrati"
  },
  {
   "start": 943.56,
   "end": 945.5,
   "text": "dug je toliko"
  },
  {
   "start": 945.5,
   "end": 947.16,
   "text": "težak na sunnjem danu"
  },
  {
   "start": 947.16,
   "end": 948.9,
   "text": "da je šeglijet koji pogine"
  },
  {
   "start": 948.9,
   "end": 951.52,
   "text": "a imala mi je dug iza sebe"
  },
  {
   "start": 951.52,
   "end": 953.58,
   "text": "nema tretman šehida zbog duga"
  },
  {
   "start": 953.58,
   "end": 955.3,
   "text": "koji je ostavio iza sebe."
  },
  {
   "start": 958.45,
   "end": 959.81,
   "text": "Dug. Čak je"
  },
  {
   "start": 959.81,
   "end": 962.21,
   "text": "u vrijeme Resulullah, ne sratu sram,"
  },
  {
   "start": 962.61,
   "end": 964.37,
   "text": "bila Frank sa dužnicima"
  },
  {
   "start": 964.37,
   "end": 965.93,
   "text": "pejgabara, ne sratu sram,"
  },
  {
   "start": 966.07,
   "end": 968.03,
   "text": "nije klanjao džena, zu namaz."
  },
  {
   "start": 971.38,
   "end": 972.7,
   "text": "Dok neko"
  },
  {
   "start": 972.7,
   "end": 974.8,
   "text": "ne bi prihvatio tu obavezu da vrati"
  },
  {
   "start": 974.8,
   "end": 976.34,
   "text": "dug za nekova."
  },
  {
   "start": 979.14,
   "end": 979.88,
   "text": "Se vrati dug."
  },
  {
   "start": 986.56,
   "end": 988.54,
   "text": "Jedne prilike pejgabara, ne sratu sram,"
  },
  {
   "start": 988.62,
   "end": 990.5,
   "text": "je, kaže, pozajmio neko"
  },
  {
   "start": 990.5,
   "end": 992.04,
   "text": "mladunče od dem."
  },
  {
   "start": 994.73,
   "end": 996.07,
   "text": "I onaj prenosijac kaže"
  },
  {
   "start": 996.07,
   "end": 998.25,
   "text": "došlo je vrijeme"
  },
  {
   "start": 998.25,
   "end": 1000.53,
   "text": "do pejgandara R.S. vrati"
  },
  {
   "start": 1000.53,
   "end": 1002.83,
   "text": "taj dug određenom čovjeku"
  },
  {
   "start": 1002.83,
   "end": 1004.17,
   "text": "od koga je to pozainio"
  },
  {
   "start": 1004.17,
   "end": 1006.45,
   "text": "kaže mu tom"
  },
  {
   "start": 1006.45,
   "end": 1008.41,
   "text": "prenosiocu, kaže, idi tamo i"
  },
  {
   "start": 1008.41,
   "end": 1008.95,
   "text": "pogledaj"
  },
  {
   "start": 1008.95,
   "end": 1012.43,
   "text": "od zekata što je došto kod poslanika"
  },
  {
   "start": 1012.43,
   "end": 1014.73,
   "text": "R.S. vratu sram, daj mu to mladunče"
  },
  {
   "start": 1014.73,
   "end": 1016.57,
   "text": "onako kako sam ja"
  },
  {
   "start": 1016.57,
   "end": 1018.01,
   "text": "uzeo od njega"
  },
  {
   "start": 1018.01,
   "end": 1020.81,
   "text": "kaže čovjek, ja rasuljala"
  },
  {
   "start": 1020.81,
   "end": 1022.35,
   "text": "nema takvo"
  },
  {
   "start": 1022.35,
   "end": 1023.57,
   "text": "mladunče"
  },
  {
   "start": 1023.57,
   "end": 1027.44,
   "text": "kaže, a šta ima?"
  },
  {
   "start": 1027.92,
   "end": 1031.06,
   "text": "kaže, nešto bolje od toga"
  },
  {
   "start": 1031.16,
   "end": 1033.54,
   "text": "Pa kaže, daj mu i ono što je bolje od toga."
  },
  {
   "start": 1034.26,
   "end": 1043.93,
   "text": "Pa se kaže, u hadisu, kaže, među njima ne nalazim, osim bolje, odrasle kamine."
  },
  {
   "start": 1044.41,
   "end": 1048.59,
   "text": "Pa poslanik Aliiz Ratov 7 kaže, daj mu, daj mu je."
  },
  {
   "start": 1049.43,
   "end": 1052.25,
   "text": "Jer su najbolji ljudi, oni koji najlepše vraćaju dug."
  },
  {
   "start": 1052.25,
   "end": 1060.67,
   "text": "I u ovim hadisom nam poslanik poručuje da i kada vraćamo dug,"
  },
  {
   "start": 1060.67,
   "end": 1062.59,
   "text": "trebamo vratiti"
  },
  {
   "start": 1062.59,
   "end": 1063.55,
   "text": "najlepše"
  },
  {
   "start": 1063.55,
   "end": 1066.95,
   "text": "na najlepši mogući način"
  },
  {
   "start": 1066.95,
   "end": 1067.73,
   "text": "vratiti dug"
  },
  {
   "start": 1067.73,
   "end": 1071.98,
   "text": "i kao"
  },
  {
   "start": 1071.98,
   "end": 1075.02,
   "text": "zadnja tačka"
  },
  {
   "start": 1075.02,
   "end": 1077.48,
   "text": "dakle za ovu kutvu"
  },
  {
   "start": 1077.48,
   "end": 1078.84,
   "text": "jeste"
  },
  {
   "start": 1078.84,
   "end": 1081.84,
   "text": "pitanje Tazir i Teuba"
  },
  {
   "start": 1081.84,
   "end": 1083.24,
   "text": "što je Tazir? Tazir je"
  },
  {
   "start": 1083.24,
   "end": 1085.86,
   "text": "dakle sankcija"
  },
  {
   "start": 1085.86,
   "end": 1088.2,
   "text": "koja se vrši"
  },
  {
   "start": 1088.2,
   "end": 1090.06,
   "text": "kao odpojna mjera"
  },
  {
   "start": 1090.06,
   "end": 1093.06,
   "text": "nad onim čovjekom"
  },
  {
   "start": 1093.06,
   "end": 1095.22,
   "text": "koji je učinio neku vrstu nepravde"
  },
  {
   "start": 1095.22,
   "end": 1096.4,
   "text": "u društvo."
  },
  {
   "start": 1097.4,
   "end": 1098.9,
   "text": "A zato nije određena"
  },
  {
   "start": 1098.9,
   "end": 1101.14,
   "text": "precizna kazna, kao za krađu"
  },
  {
   "start": 1101.14,
   "end": 1102.84,
   "text": "što je određena kazna, kao za blud"
  },
  {
   "start": 1102.84,
   "end": 1104.22,
   "text": "što je određena kazna, itd."
  },
  {
   "start": 1104.88,
   "end": 1106.5,
   "text": "Ima precizne kazne,"
  },
  {
   "start": 1107.04,
   "end": 1108.84,
   "text": "kaže se za precizne kazne"
  },
  {
   "start": 1108.84,
   "end": 1110.14,
   "text": "hudud."
  },
  {
   "start": 1112.0,
   "end": 1112.6,
   "text": "Ili had."
  },
  {
   "start": 1112.72,
   "end": 1113.5,
   "text": "Had kazna."
  },
  {
   "start": 1114.0,
   "end": 1114.32,
   "text": "Had."
  },
  {
   "start": 1116.22,
   "end": 1118.36,
   "text": "Precizna kazna. Ovo ta zir je"
  },
  {
   "start": 1118.36,
   "end": 1120.56,
   "text": "neprecizna kazna kao"
  },
  {
   "start": 1120.56,
   "end": 1122.12,
   "text": "blaža kazna,"
  },
  {
   "start": 1122.12,
   "end": 1124.28,
   "text": "kao odgojna mjera za onoga"
  },
  {
   "start": 1124.28,
   "end": 1125.76,
   "text": "koji čini nepravdu."
  },
  {
   "start": 1128.17,
   "end": 1128.99,
   "text": "Koji čini nepravdu."
  },
  {
   "start": 1129.39,
   "end": 1131.65,
   "text": "Jedan od vidova ta Azira"
  },
  {
   "start": 1131.65,
   "end": 1133.51,
   "text": "ili te blaže"
  },
  {
   "start": 1133.51,
   "end": 1134.97,
   "text": "sankcije"
  },
  {
   "start": 1134.97,
   "end": 1137.03,
   "text": "koje je primjenjivao poslanik"
  },
  {
   "start": 1137.03,
   "end": 1138.55,
   "text": "sada Laune Osrlan jeste"
  },
  {
   "start": 1138.55,
   "end": 1139.63,
   "text": "bojkot."
  },
  {
   "start": 1140.91,
   "end": 1141.87,
   "text": "Bojkot."
  },
  {
   "start": 1142.77,
   "end": 1143.61,
   "text": "Tri jashaba"
  },
  {
   "start": 1143.61,
   "end": 1147.41,
   "text": "su izostala iz bitke"
  },
  {
   "start": 1147.41,
   "end": 1149.65,
   "text": "na Tebuk bezapravdani razlog."
  },
  {
   "start": 1152.0,
   "end": 1152.38,
   "text": "Pa je"
  },
  {
   "start": 1152.38,
   "end": 1153.84,
   "text": "peygamber Ales Ratus Ram"
  },
  {
   "start": 1153.84,
   "end": 1155.9,
   "text": "naredio muslimanima"
  },
  {
   "start": 1155.9,
   "end": 1158.0,
   "text": "da se ta trojica"
  },
  {
   "start": 1158.0,
   "end": 1159.56,
   "text": "ashaba ne razgovaraju"
  },
  {
   "start": 1159.56,
   "end": 1161.98,
   "text": "i znate koliko vremena nisu razgovarali"
  },
  {
   "start": 1161.98,
   "end": 1167.03,
   "text": "50 dana nisu razgovarali"
  },
  {
   "start": 1167.03,
   "end": 1171.02,
   "text": "50 dana"
  },
  {
   "start": 1171.02,
   "end": 1174.16,
   "text": "jer pitanje"
  },
  {
   "start": 1174.16,
   "end": 1176.46,
   "text": "od općeg"
  },
  {
   "start": 1176.46,
   "end": 1178.14,
   "text": "muslimanskog interesa"
  },
  {
   "start": 1178.14,
   "end": 1180.32,
   "text": "je bilo da se ljudi odazovu"
  },
  {
   "start": 1180.32,
   "end": 1182.38,
   "text": "pozivu u džihad"
  },
  {
   "start": 1182.38,
   "end": 1183.72,
   "text": "u to vrijeme"
  },
  {
   "start": 1183.72,
   "end": 1187.98,
   "text": "a kada je pitanje hatara lahom"
  },
  {
   "start": 1187.98,
   "end": 1190.62,
   "text": "bojhod može da traje i više"
  },
  {
   "start": 1190.62,
   "end": 1193.62,
   "text": "čekajući tog čovjeka"
  },
  {
   "start": 1193.62,
   "end": 1196.52,
   "text": "dok se ne pokaje"
  },
  {
   "start": 1196.52,
   "end": 1198.32,
   "text": "i ne popravi svoje stanje"
  },
  {
   "start": 1198.32,
   "end": 1200.8,
   "text": "i svoje ponašanje dok ne popravi."
  },
  {
   "start": 1201.5,
   "end": 1202.48,
   "text": "Bojkot može da traje"
  },
  {
   "start": 1202.48,
   "end": 1204.76,
   "text": "ne samo 50 dana"
  },
  {
   "start": 1204.76,
   "end": 1207.08,
   "text": "kao što je to radio"
  },
  {
   "start": 1207.08,
   "end": 1208.32,
   "text": "poslanik ali srato sram."
  },
  {
   "start": 1208.72,
   "end": 1210.54,
   "text": "Bojkot može da traje više"
  },
  {
   "start": 1210.54,
   "end": 1211.42,
   "text": "vremenski"
  },
  {
   "start": 1211.42,
   "end": 1214.08,
   "text": "a kad je hadar Allahov"
  },
  {
   "start": 1214.08,
   "end": 1215.9,
   "text": "po sredini."
  },
  {
   "start": 1216.66,
   "end": 1218.58,
   "text": "A inače, zbog nekih naših"
  },
  {
   "start": 1218.58,
   "end": 1220.38,
   "text": "razmirica sitnih ovako"
  },
  {
   "start": 1220.38,
   "end": 1223.1,
   "text": "sa ulice, onda se u hadijecu kaže"
  },
  {
   "start": 1223.1,
   "end": 1224.68,
   "text": "neka musliman"
  },
  {
   "start": 1224.68,
   "end": 1227.22,
   "text": "ne izbjegava drugog muslimana"
  },
  {
   "start": 1227.22,
   "end": 1228.06,
   "text": "više od tri dana."
  },
  {
   "start": 1231.61,
   "end": 1233.87,
   "text": "Ali ovo bilo, znači, u pitanje"
  },
  {
   "start": 1233.87,
   "end": 1235.47,
   "text": "poziv na džihad."
  },
  {
   "start": 1237.31,
   "end": 1237.87,
   "text": "U to vrijeme."
  },
  {
   "start": 1239.33,
   "end": 1239.71,
   "text": "E sad,"
  },
  {
   "start": 1240.25,
   "end": 1242.39,
   "text": "bojkot oni koji čine nepravdu"
  },
  {
   "start": 1242.39,
   "end": 1244.03,
   "text": "je dozvoren"
  },
  {
   "start": 1244.03,
   "end": 1245.63,
   "text": "i više od 50 dana."
  },
  {
   "start": 1249.86,
   "end": 1251.1,
   "text": "Nemoj da imamo kontakt"
  },
  {
   "start": 1251.1,
   "end": 1253.76,
   "text": "sa tim ljudima, sa prevarantima,"
  },
  {
   "start": 1256.12,
   "end": 1257.04,
   "text": "sa onima koji nam"
  },
  {
   "start": 1257.04,
   "end": 1259.02,
   "text": "žele uzeti novac"
  },
  {
   "start": 1259.02,
   "end": 1260.2,
   "text": "bespravno."
  },
  {
   "start": 1260.92,
   "end": 1262.44,
   "text": "Nema kontakti sa njima."
  },
  {
   "start": 1263.88,
   "end": 1265.42,
   "text": "Dok se ne pokaju"
  },
  {
   "start": 1265.42,
   "end": 1267.0,
   "text": "i dok se ne poprave"
  },
  {
   "start": 1267.0,
   "end": 1269.04,
   "text": "u svome ponašanju."
  },
  {
   "start": 1270.9,
   "end": 1271.2,
   "text": "E sad,"
  },
  {
   "start": 1271.62,
   "end": 1273.16,
   "text": "to je tanzir."
  },
  {
   "start": 1274.8,
   "end": 1275.54,
   "text": "I te oba"
  },
  {
   "start": 1275.54,
   "end": 1277.24,
   "text": "kaže se"
  },
  {
   "start": 1277.24,
   "end": 1279.86,
   "text": "a one ko se pokaje"
  },
  {
   "start": 1279.86,
   "end": 1281.32,
   "text": "nakon svoga"
  },
  {
   "start": 1281.32,
   "end": 1283.24,
   "text": "zuluma i poporbi se"
  },
  {
   "start": 1283.24,
   "end": 1284.74,
   "text": "Allah će mu oprostiti."
  },
  {
   "start": 1287.01,
   "end": 1288.09,
   "text": "Allah će mu oprostiti."
  },
  {
   "start": 1290.21,
   "end": 1293.85,
   "text": "I na sudnjem danu sve će biti javno izloženo."
  },
  {
   "start": 1295.31,
   "end": 1300.75,
   "text": "E sad, draga braćo, vratimo tuđe stvari, tuđi imetak drugome kome pripada,"
  },
  {
   "start": 1300.75,
   "end": 1313.01,
   "text": "prije nego dođe sudnji dan kada će da se vrši uspoređivanje ili hakovi prava na sudnjem danu,"
  },
  {
   "start": 1313.01,
   "end": 1327.53,
   "text": "Kada neće se davati dinari i dirhemi, već će ljudi nadomestiti te nepravde koje su nanijeli jedni drugima, dakle nadomestiti svojim dobrim ili lošim dijelima nasunjime dama."
  },
  {
   "start": 1327.53,
   "end": 1347.83,
   "text": "Zato molim Allah Zalešanohu da ovo bude pouka za nas, da tuđe je tuđe, a naše je naše i da to vjerno čuvamo, kao što je pejgambara Reis Vratosram spomenuo, dakle život, čast i metak su sveti nepovredivi i to je uopšte dobro za svakog pojedinca."
  },
  {
   "start": 1347.83,
   "end": 1350.21,
   "text": "za svakog pojedinca."
  },
  {
   "start": 1350.93,
   "end": 1351.71,
   "text": "Svaki pojedinac"
  },
  {
   "start": 1351.71,
   "end": 1353.11,
   "text": "raspoleše sa tim stvarima"
  },
  {
   "start": 1353.11,
   "end": 1354.89,
   "text": "i to dobro trebamo čuvati"
  },
  {
   "start": 1354.89,
   "end": 1356.47,
   "text": "i ne povrediti"
  },
  {
   "start": 1356.47,
   "end": 1359.79,
   "text": "te zaštičene"
  },
  {
   "start": 1359.79,
   "end": 1361.15,
   "text": "vrednosti koje širiat je"
  },
  {
   "start": 1361.15,
   "end": 1363.19,
   "text": "naredio da se"
  },
  {
   "start": 1363.19,
   "end": 1364.73,
   "text": "dobro čuva i pazi"
  },
  {
   "start": 1364.73,
   "end": 1366.61,
   "text": "na drugoga. Neka nasa"
  },
  {
   "start": 1366.61,
   "end": 1368.69,
   "text": "vanašanohu, svi u nas oputi"
  },
  {
   "start": 1368.69,
   "end": 1369.41,
   "text": "na pravi pot."
  },
  {
   "start": 1379.56,
   "end": 1381.14,
   "text": "فاستمعونه وانستون"
  },
  {
   "start": 1381.14,
   "end": 1382.02,
   "text": "وعلاهم ترحمون"
  },
  {
   "start": 1382.02,
   "end": 1383.3,
   "text": "اعوذ بالله"
  },
  {
   "start": 1383.3,
   "end": 1384.36,
   "text": "إن الشيطان الرجيم"
  },
  {
   "start": 1384.36,
   "end": 1385.76,
   "text": "بسم الله الرحمن الرحيم"
  },
  {
   "start": 1385.76,
   "end": 1388.38,
   "text": "إن الله يأمر بالعد والإحسان"
  },
  {
   "start": 1388.38,
   "end": 1389.62,
   "text": "وإيطاء بالقرب"
  },
  {
   "start": 1389.62,
   "end": 1392.7,
   "text": "وينهى عن الفحشاء والمنكر والبغي"
  },
  {
   "start": 1392.7,
   "end": 1394.7,
   "text": "يعظكم لعلكم تذكرون"
  },
  {
   "start": 1394.7,
   "end": 1396.5,
   "text": "ولذكر الله أكبر"
  },
  {
   "start": 1396.5,
   "end": 1398.9,
   "text": "والله يعلم ما تصنعون"
  },
  {
   "start": 1398.9,
   "end": 1399.78,
   "text": "اقم السلام"
  }
 ]
}